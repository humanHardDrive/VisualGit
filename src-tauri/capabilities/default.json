{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window and the merge, diff, submodule and settings windows",
  "windows": ["main", "merge-*", "diff-*", "submodule-*", "settings"],
  "permissions": ["core:default", "core:window:allow-destroy", "dialog:allow-open", "dialog:allow-ask", "dialog:allow-message", "core:webview:allow-set-webview-zoom"]
}
